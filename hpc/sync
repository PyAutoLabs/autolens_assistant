#!/usr/bin/env bash
# hpc/sync — bidirectional project sync between local machine and HPC
#
# SETUP
#   cp hpc/sync.conf.example hpc/sync.conf
#   # Edit hpc/sync.conf with your HPC host, base path, and project name.
#   # sync.conf is gitignored — it stays on your machine only.
#
# USAGE (run from the project root or hpc/ directory)
#
# Transfer:
#   hpc/sync push                    Push code and data to the HPC
#   hpc/sync push --no-data          Push code only (skip dataset/)
#   hpc/sync pull [dir ...]          Download SLURM logs then results (only the named roots, if given)
#   hpc/sync logs                    Download SLURM output/error logs only (fast, use mid-run)
#   hpc/sync sync                    Push, then pull (default)
#   hpc/sync sync --no-data          Push code only, then pull
#   hpc/sync push-data-init          First-time dataset upload via tar pipe
#   hpc/sync pull-full               Full output download via tar pipe
#   hpc/sync status [dir ...]        Dry run — show what would transfer
#
# Jobs (no manual SSH required):
#   hpc/sync submit [gpu|cpu] <script> [sbatch arg ...]       Submit a SLURM job
#   hpc/sync push-submit [gpu|cpu] <script> [sbatch arg ...]  Push code then submit
#   hpc/sync jobs                    Show queued/running jobs (squeue)
#   hpc/sync sacct                   Show job history and exit codes (sacct)
#   hpc/sync cancel <job_id>         Cancel a job by ID (recorded like `act cancel`)
#   hpc/sync wait-and-pull [secs]    Poll until all jobs finish, then pull (default: 60s)
#
# Campaigns (python -m autofit.campaign on the cluster; one ssh call each):
#   hpc/sync status <campaign.yaml>              Collect the campaign, pull its digest, print it
#   hpc/sync plan <campaign.yaml> [plan arg ...] Propose resources from evidence (submits nothing)
#   hpc/sync pilot <campaign.yaml> [pilot arg ...]
#                                                Choose a stratified pilot slice (submits nothing)
#   hpc/sync resubmit <campaign.yaml> --stage S --class C
#                                                Write a resubmit proposal (submits nothing)
#   hpc/sync report <campaign.yaml> [arg ...]    End-of-campaign report, energy and carbon
#   hpc/sync act <action> <campaign.yaml|name> <arg ...>
#                                                Start or change campaign jobs, and log it: submit,
#                                                resubmit, hold, release, throttle, update-pending, cancel
#
# Inspect:
#   hpc/sync tail [gpu|cpu]          Stream live SLURM log output (Ctrl+C to stop)
#   hpc/sync du                      Show remote disk usage
#   hpc/sync check                   Verify SSH connection and remote paths
#   hpc/sync clear-logs [gpu|cpu]    Delete SLURM output/error log files
#
#   hpc/sync help                    Print the command list

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
CONF="${SCRIPT_DIR}/sync.conf"

# `help` is answered before the configuration below, which hard-fails when
# HPC_HOST/HPC_BASE are unset — the command list has to be readable by someone
# who has not written hpc/sync.conf yet.
case "${1:-}" in
    help|--help|-h) HELP_REQUESTED=1 ;;
    *)              HELP_REQUESTED=0 ;;
esac

# ---------------------------------------------------------------------------
# Configuration — loaded from hpc/sync.conf, with environment variable overrides
# ---------------------------------------------------------------------------
[[ -f "$CONF" ]] && source "$CONF"

if [[ "$HELP_REQUESTED" -eq 0 ]]; then
    HPC_HOST="${HPC_HOST:?HPC_HOST not set. Copy hpc/sync.conf.example → hpc/sync.conf and edit it.}"
    HPC_BASE="${HPC_BASE:?HPC_BASE not set. Copy hpc/sync.conf.example → hpc/sync.conf and edit it.}"
fi
HPC_HOST="${HPC_HOST:-}"
HPC_BASE="${HPC_BASE:-}"
PROJECT_NAME="${PROJECT_NAME:-$(basename "$PROJECT_ROOT")}"

REMOTE="${HPC_HOST}:${HPC_BASE}/${PROJECT_NAME}"
REMOTE_PATH="${HPC_BASE}/${PROJECT_NAME}"

# How the campaign verbs get a Python with PyAutoFit on the cluster: a command run in
# the remote project directory before `python -m autofit.campaign`. The default sources
# the project's activate.sh (pushed with the code). HPC_PYTHON names the interpreter.
HPC_ENV="${HPC_ENV:-[ -f activate.sh ] && source activate.sh >/dev/null 2>&1; true}"
HPC_PYTHON="${HPC_PYTHON:-python}"

# ---------------------------------------------------------------------------
# Transfer lists
# ---------------------------------------------------------------------------

# Code and config — synced normally. Changed files are updated, new files added.
CODE_DIRS=(config hpc scripts slam_pipeline simulators)

# Top-level source files that live at the project root (not in a subdirectory).
ROOT_FILES=(activate.sh util.py __init__.py README.md LICENSE)

# Raw data — pushed with --ignore-existing.
# FITS files are written once and never modified, so any file already present
# on the HPC is guaranteed correct. Skipping re-checksumming avoids scanning
# the entire archive on every sync (critical for large datasets).
DATA_DIRS=(dataset)

# SLURM stdout/stderr logs — pulled first; small files, fast to inspect mid-run.
LOG_DIRS=(
    hpc/batch_gpu/output
    hpc/batch_gpu/error
    hpc/batch_cpu/output
    hpc/batch_cpu/error
)

# Pulled from the HPC after jobs finish. A directory that does not exist on the
# HPC is skipped rather than failing.
PULL_DIRS=(output)

# Extra roots the caller asks for, space-separated — e.g. a run written to a
# custom PYAUTO_OUTPUT_DIR, or the `output*` roots a check-in passes — so they
# are pulled without this list being edited by hand. The expansion is
# deliberately unquoted: word-splitting is how the list is parsed. Appended,
# never replacing; an unset variable leaves the pull exactly as it was.
if [[ -n "${PYAUTO_PULL_DIRS:-}" ]]; then
    for _extra in ${PYAUTO_PULL_DIRS}; do
        [[ " ${PULL_DIRS[*]} " == *" ${_extra} "* ]] || PULL_DIRS+=("${_extra}")
    done
    unset _extra
fi

# Restrict PULL_DIRS to the roots named on the command line, for this call only.
#
# `pull` and `status` walk every root in PULL_DIRS, which for a large tree means
# rsync stats tens of thousands of result files. Naming the roots skips that
# walk. No argument leaves PULL_DIRS exactly as it was.
#
# A name is validated against the list built above, PYAUTO_PULL_DIRS included:
# a typo pulls nothing silently, which on a several-hour transfer is worse than
# an error.
restrict_pull_dirs() {
    [[ $# -eq 0 ]] && return 0

    local selected=()
    for requested in "$@"; do
        # Global flags (`--no-data`) are consumed by the dispatcher below.
        [[ "${requested}" == -* ]] && continue
        if [[ " ${PULL_DIRS[*]} " == *" ${requested} "* ]]; then
            selected+=("${requested}")
        else
            echo "ERROR: '${requested}' is not one of this project's result roots: ${PULL_DIRS[*]}"
            echo "       (add one with PYAUTO_PULL_DIRS='<name> ...')"
            exit 1
        fi
    done

    [[ ${#selected[@]} -gt 0 ]] && PULL_DIRS=("${selected[@]}")
    return 0
}

# ---------------------------------------------------------------------------
# rsync options
#   -a                    archive (timestamps, permissions, symlinks)
#   -z                    compress in transit (big win for text/JSON/YAML)
#   --skip-compress       skip compression for formats that don't benefit
#   --partial             keep partial files so interrupted transfers resume
#   --info=progress2      single updating line per file (less noisy than -v)
#   -e / ControlMaster    reuse a single SSH connection across all rsync calls;
#                         avoids a fresh TLS handshake for every directory loop
# ---------------------------------------------------------------------------
RSYNC=(rsync -az --partial --info=progress2
    --skip-compress=fits/gz/bz2/xz/zst
    -e "ssh -o ControlMaster=auto -o ControlPath=/tmp/ssh_mux_%h_%p_%r -o ControlPersist=120")

EXCLUDES=(
    --exclude='__pycache__/'
    --exclude='*.pyc'
    --exclude='.git/'
    --exclude='*.egg-info/'
    --exclude='sync.conf'          # never push the local HPC config
)

# Pull with rsync, telling a missing or still-being-written directory (rsync exit
# 23/24: tolerated, the pull carries on) apart from a real failure — a dropped
# connection (255), a full disk — which is reported, not passed off as a skip.
rsync_pull() {
    local what="${1}"
    shift
    local rc=0
    "${RSYNC[@]}" "$@" || rc=$?
    case "${rc}" in
        0) ;;
        23|24) echo "    skip: ${what} not on the HPC yet, or still being written (rsync exit ${rc})" ;;
        255) echo "    WARNING: ${what} not pulled — the ssh connection failed (rsync exit 255)" >&2 ;;
        *) echo "    WARNING: ${what} not pulled — rsync exit ${rc}" >&2 ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
push() {
    local dryrun="${1:-}"
    local failed=0

    # On a first push the remote project directory does not exist yet. rsync
    # only creates the last path level, so every CODE_DIRS transfer below would
    # fail with "mkdir failed: No such file or directory" — and because they run
    # in parallel, the failures are invisible unless collected (see wait loop).
    if [[ -z "$dryrun" ]]; then
        ssh "${HPC_HOST}" "mkdir -p '${HPC_BASE}/${PROJECT_NAME}'"
    fi

    echo "==> [push] code/config  →  ${REMOTE}"
    local pids=() names=()
    for dir in "${CODE_DIRS[@]}"; do
        local src="${PROJECT_ROOT}/${dir}/"
        if [[ ! -d "$src" ]]; then
            echo "    skip: ${dir}/ not found locally"
            continue
        fi
        echo "    ${dir}/"
        "${RSYNC[@]}" "${EXCLUDES[@]}" ${dryrun} \
            "${src}" "${REMOTE}/${dir}/" &
        pids+=("$!")
        names+=("${dir}")
    done
    # Plain `wait` reports only its own status, so a backgrounded rsync that
    # failed would be swallowed even under `set -e`. Wait on each PID instead.
    if (( ${#pids[@]} > 0 )); then
        for i in "${!pids[@]}"; do
            if ! wait "${pids[$i]}"; then
                echo "    ERROR: rsync of ${names[$i]}/ failed" >&2
                failed=1
            fi
        done
    fi

    echo "    [root files]"
    local existing_root_files=()
    for f in "${ROOT_FILES[@]}"; do
        [[ -f "${PROJECT_ROOT}/${f}" ]] && existing_root_files+=("${PROJECT_ROOT}/${f}")
    done
    if [[ ${#existing_root_files[@]} -gt 0 ]]; then
        "${RSYNC[@]}" "${EXCLUDES[@]}" ${dryrun} \
            "${existing_root_files[@]}" "${REMOTE}/"
    fi

    if [[ -z "${SKIP_DATA:-}" ]]; then
        echo ""
        echo "==> [push] data  →  ${REMOTE}  (--ignore-existing: skips files already on HPC)"
        local data_pids=() data_names=()
        for dir in "${DATA_DIRS[@]}"; do
            local src="${PROJECT_ROOT}/${dir}/"
            if [[ ! -d "$src" ]]; then
                echo "    skip: ${dir}/ not found locally"
                continue
            fi
            echo "    ${dir}/"
            "${RSYNC[@]}" "${EXCLUDES[@]}" --ignore-existing ${dryrun} \
                "${src}" "${REMOTE}/${dir}/" &
            data_pids+=("$!")
            data_names+=("${dir}")
        done
        if (( ${#data_pids[@]} > 0 )); then
            for i in "${!data_pids[@]}"; do
                if ! wait "${data_pids[$i]}"; then
                    echo "    ERROR: rsync of ${data_names[$i]}/ failed" >&2
                    failed=1
                fi
            done
        fi
    else
        echo ""
        echo "    [data skipped — --no-data]"
    fi

    # Fail loudly rather than letting push-submit sbatch against a remote that
    # is missing hpc/batch_gpu (job 330464 postmortem, 2026-07-16).
    if (( failed )); then
        echo "" >&2
        echo "==> [push] FAILED — one or more transfers did not complete." >&2
        echo "    The remote project tree is incomplete; do not submit jobs." >&2
        return 1
    fi
}

push_data_init() {
    echo "==> [push-data-init] first-time dataset upload via tar pipe  →  ${REMOTE}"
    echo "    Use this once for a fresh HPC destination."
    echo "    For subsequent syncs, 'push' (rsync --ignore-existing) is faster."
    echo ""

    for dir in "${DATA_DIRS[@]}"; do
        local src="${PROJECT_ROOT}/${dir}/"
        if [[ ! -d "$src" ]]; then
            echo "    skip: ${dir}/ not found locally"
            continue
        fi
        local file_count size
        file_count=$(find "$src" -type f | wc -l)
        size=$(du -sh "$src" | cut -f1)
        echo "    ${dir}/  (${file_count} files, ${size})"
        # No compression: FITS files are binary and don't compress meaningfully.
        # tar streams directly into ssh, so no temporary archive is created locally.
        tar cf - -C "${PROJECT_ROOT}" "${dir}" | \
            ssh "${HPC_HOST}" "mkdir -p '${HPC_BASE}/${PROJECT_NAME}' && tar xf - -C '${HPC_BASE}/${PROJECT_NAME}/'"
    done
}

pull_logs() {
    local dryrun="${1:-}"

    echo "<== [logs] SLURM output/error logs  ←  ${REMOTE}"
    for dir in "${LOG_DIRS[@]}"; do
        local remote_dir="${REMOTE}/${dir}/"
        local local_dir="${PROJECT_ROOT}/${dir}/"
        # Remote log dirs may not exist yet if no jobs have run
        if [[ -z "$dryrun" ]]; then
            ssh "${HPC_HOST}" "mkdir -p '${HPC_BASE}/${PROJECT_NAME}/${dir}'" 2>/dev/null || true
        fi
        mkdir -p "$local_dir"
        echo "    ${dir}/"
        rsync_pull "${dir}/" "${EXCLUDES[@]}" --update ${dryrun} \
            "${remote_dir}" "${local_dir}"
    done
}

pull() {
    local dryrun="${1:-}"

    pull_logs "${dryrun}"
    echo ""
    echo "<== [pull] results  ←  ${REMOTE}"
    local zip_count=0
    for dir in "${PULL_DIRS[@]}"; do
        echo "    ${dir}/"
        mkdir -p "${PROJECT_ROOT}/${dir}"
        # --update          skip local files that are newer than the remote copy
        # --exclude         omit search_internal (large sampler state, not needed locally)
        # A root that is not on the HPC (no job has written it yet) is skipped,
        # not created there; rsync partial-transfer warnings (exit 23/24) while
        # jobs are still writing are tolerated the same way (see rsync_pull).
        rsync_pull "${dir}/" "${EXCLUDES[@]}" \
            --update \
            --exclude='search_internal' \
            ${dryrun} \
            "${REMOTE}/${dir}/" \
            "${PROJECT_ROOT}/${dir}/"

        # Unzip any new .zip files immediately after rsync
        if [[ -z "$dryrun" ]]; then
            while IFS= read -r -d '' zipfile; do
                local target="${zipfile%.zip}"
                if [[ ! -d "$target" ]]; then
                    unzip -q -o "$zipfile" -d "$target" && (( zip_count++ ))
                fi
            done < <(find "${PROJECT_ROOT}/${dir}" -name '*.zip' -print0 2>/dev/null)
        fi
    done
    echo ""
    echo "    extracted ${zip_count} archive(s)"
}

pull_full() {
    echo "<== [pull-full] full output download via tar pipe  ←  ${REMOTE}"
    echo "    Downloads all of output/ in one stream — avoids per-file rsync overhead."
    echo "    For incremental pulls as jobs finish, use 'pull' instead."
    echo ""

    for dir in "${PULL_DIRS[@]}"; do
        echo "    ${dir}/"
        mkdir -p "${PROJECT_ROOT}/${dir}"
        # search_internal excluded — large sampler state, not needed locally
        if command -v pv &>/dev/null; then
            ssh "${HPC_HOST}" \
                "tar cf - --exclude='search_internal' -C '${HPC_BASE}/${PROJECT_NAME}' '${dir}'" | \
                pv -r -t -b | \
                tar xf - -C "${PROJECT_ROOT}/"
        else
            echo "    (no live rate — install pv for progress: sudo apt install pv)"
            ssh "${HPC_HOST}" \
                "tar cf - --exclude='search_internal' -C '${HPC_BASE}/${PROJECT_NAME}' '${dir}'" | \
                tar xf - -C "${PROJECT_ROOT}/"
        fi

        # Unzip any new .zip files immediately after download
        local zip_count=0
        while IFS= read -r -d '' zipfile; do
            local target="${zipfile%.zip}"
            if [[ ! -d "$target" ]]; then
                unzip -q -o "$zipfile" -d "$target" && (( zip_count++ ))
            fi
        done < <(find "${PROJECT_ROOT}/${dir}" -name '*.zip' -print0 2>/dev/null)
        echo "    extracted ${zip_count} archive(s)"
    done
}

status() {
    echo "========================================"
    echo " DRY RUN — nothing will be transferred "
    echo "========================================"
    echo ""
    push "--dry-run"
    echo ""
    pull "--dry-run"
}

# ---------------------------------------------------------------------------
# Job commands
# ---------------------------------------------------------------------------

submit_usage() {
    local verb="${1}"
    echo "Usage: $(basename "$0") ${verb} [gpu|cpu] <script_name> [sbatch arg ...]"
    echo "  e.g. hpc/sync ${verb} gpu template"
    echo ""
    echo "  Anything after <script_name> is passed straight to sbatch, which is how a"
    echo "  submit script's variables are overridden — sbatch does not carry your"
    echo "  login shell's exports into the job:"
    echo "    hpc/sync ${verb} cpu template --export=ALL,SAMPLE=my_sample"
}

submit() {
    local batch_type="${1:-}"
    local script_name="${2:-}"

    if [[ -z "$batch_type" || -z "$script_name" ]]; then
        submit_usage submit
        exit 1
    fi
    if [[ "$batch_type" != "gpu" && "$batch_type" != "cpu" ]]; then
        echo "ERROR: batch type must be 'gpu' or 'cpu', got: ${batch_type}"
        exit 1
    fi

    # Everything after the script name is an sbatch argument (`--export=...`,
    # `--array=...`, a different `--time`). They go *before* the script name,
    # where sbatch expects its own options, and each is shell-quoted for the
    # remote shell ssh runs the command line through, so an argument containing
    # spaces arrives as one.
    local sbatch_args=""
    local arg
    for arg in "${@:3}"; do
        sbatch_args+="$(printf '%q' "${arg}") "
    done

    local remote_dir="${HPC_BASE}/${PROJECT_NAME}/hpc/batch_${batch_type}"
    echo "==> [submit] sbatch ${*:3} ${script_name}  (batch_${batch_type})  @  ${HPC_HOST}"
    echo ""
    ssh "${HPC_HOST}" "cd '${remote_dir}' && sbatch ${sbatch_args}'${script_name}'"
}

push_submit() {
    local batch_type="${1:-}"
    local script_name="${2:-}"

    if [[ -z "$batch_type" || -z "$script_name" ]]; then
        submit_usage push-submit
        exit 1
    fi

    push
    echo ""
    submit "$@"
}

jobs_cmd() {
    echo "==> [jobs] SLURM queue  @  ${HPC_HOST}"
    echo ""
    ssh "${HPC_HOST}" "squeue --me 2>/dev/null || squeue -u \"\$(id -un)\""
}

sacct_cmd() {
    echo "==> [sacct] SLURM accounting  @  ${HPC_HOST}"
    echo ""
    ssh "${HPC_HOST}" "sacct -u \"\$(id -un)\""
}

# Kept for the old command line; it is `act cancel` under the campaign name in
# $CAMPAIGN (default `adhoc`), so it is logged like every other queue change.
cancel() {
    local job_id="${1:-}"
    if [[ -z "$job_id" ]]; then
        echo "Usage: $(basename "$0") cancel <job_id>"
        exit 1
    fi
    act cancel "${CAMPAIGN:-adhoc}" "${job_id}"
    echo "    Job ${job_id} cancelled."
}

wait_and_pull() {
    local interval="${1:-60}"
    echo "==> [wait-and-pull] polling every ${interval}s until no jobs remain  @  ${HPC_HOST}"
    echo "    Ctrl+C to abort."
    echo ""
    while true; do
        local n_running
        n_running=$(ssh "${HPC_HOST}" "squeue --me --noheader 2>/dev/null | wc -l" 2>/dev/null || echo "0")
        n_running="${n_running//[[:space:]]/}"
        if [[ "${n_running}" -eq 0 ]]; then
            echo "    $(date '+%H:%M:%S')  No jobs running — pulling results..."
            echo ""
            pull
            break
        else
            echo "    $(date '+%H:%M:%S')  ${n_running} job(s) still running — next check in ${interval}s"
            sleep "${interval}"
        fi
    done
}


# ---------------------------------------------------------------------------
# Campaign commands
#
# Each runs `python -m autofit.campaign <verb>` in the remote project directory over
# one ssh call, then pulls only the campaign's small files (digest, failure lists,
# proposals, plan, report, the action log) from <project_root>/campaign/<name>/ into
# hpc/campaign/<name>/ — never tasks.jsonl or results. The campaign file's
# project_root must be this project's path on the cluster ($HPC_BASE/$PROJECT_NAME).
#
# `act` is the only verb that starts or changes a campaign's jobs: `act submit` (the
# campaign's stages, a pilot slice with --indices), `act resubmit` (an approved
# proposal), and scontrol / scancel. Every act appends one JSON line {utc, user,
# campaign, action, args, exit} to <project_root>/campaign/<name>/actions.log on the
# cluster and prints it. (`submit` / `push-submit` above sbatch one hand-written
# script, outside any campaign.)
# ---------------------------------------------------------------------------

# The campaign name declared in a campaign.yaml (its `campaign:` line).
campaign_name() {
    local file="${1}"
    local local_file="${PROJECT_ROOT}/${file}"
    [[ -f "${file}" ]] && local_file="${file}"
    if [[ ! -f "${local_file}" ]]; then
        echo "ERROR: no campaign file ${file} (paths are relative to the project root)" >&2
        exit 1
    fi
    local name
    name="$(sed -n 's/^campaign:[[:space:]]*\([A-Za-z0-9_.-]*\).*/\1/p' "${local_file}" | head -1)"
    if [[ -z "${name}" ]]; then
        echo "ERROR: ${file} has no 'campaign: <name>' line" >&2
        exit 1
    fi
    echo "${name}"
}

# The campaign file as the cluster sees it: relative to the remote project root.
campaign_path() {
    local file="${1}"
    if [[ "${file}" == "${PROJECT_ROOT}/"* ]]; then
        file="${file#"${PROJECT_ROOT}/"}"
    fi
    echo "${file}"
}

# An argument passed to the cluster: one shell word, quoted for the remote shell.
quote_args() {
    local quoted="" arg
    for arg in "$@"; do
        quoted+="$(printf '%q' "${arg}") "
    done
    echo "${quoted}"
}

# Run `python -m autofit.campaign <verb> <args>` on the cluster (one ssh call).
campaign_remote() {
    local verb="${1}"
    shift
    ssh "${HPC_HOST}" "cd '${REMOTE_PATH}' && { ${HPC_ENV}; } && ${HPC_PYTHON} -m autofit.campaign ${verb} $(quote_args "$@")"
}

# Pull the campaign's small files into hpc/campaign/<name>/.
pull_campaign() {
    local name="${1}"
    local local_dir="${PROJECT_ROOT}/hpc/campaign/${name}"
    mkdir -p "${local_dir}"
    echo ""
    echo "<== [campaign] ${name}: digest, lists, proposals, plan, report  →  hpc/campaign/${name}/"
    rsync_pull "campaign/${name}/" \
        --include='*.md' --include='*.json' --include='failed_*.txt' --include='actions.log' \
        --exclude='*' \
        "${REMOTE}/campaign/${name}/" "${local_dir}/"
}

require_campaign_file() {
    local verb="${1}" file="${2:-}"
    if [[ -z "${file}" || "${file}" != *.y*ml ]]; then
        echo "Usage: $(basename "$0") ${verb} <campaign.yaml> [arg ...]"
        echo "  e.g. $(basename "$0") ${verb} hpc/campaign.yaml"
        exit 1
    fi
}

campaign_status() {
    require_campaign_file status "${1:-}"
    local file name rc=0
    file="$(campaign_path "${1}")"
    name="$(campaign_name "${1}")"
    echo "==> [status] collect campaign ${name}  @  ${HPC_HOST}"
    echo ""
    campaign_remote status "${file}" || rc=$?
    pull_campaign "${name}"
    return "${rc}"
}

campaign_plan() {
    require_campaign_file plan "${1:-}"
    local file name rc=0
    file="$(campaign_path "${1}")"
    name="$(campaign_name "${1}")"
    echo "==> [plan] campaign ${name}  @  ${HPC_HOST}   (nothing is submitted)"
    echo ""
    campaign_remote plan "${file}" "${@:2}" || rc=$?
    pull_campaign "${name}"
    return "${rc}"
}

campaign_pilot() {
    require_campaign_file pilot "${1:-}"
    local file name rc=0
    file="$(campaign_path "${1}")"
    name="$(campaign_name "${1}")"
    echo "==> [pilot] choose a pilot slice of campaign ${name}  @  ${HPC_HOST}   (nothing is submitted)"
    echo "    Approve it, then: $(basename "$0") act submit ${1} --indices <the pilot's indices>"
    echo ""
    campaign_remote pilot "${file}" "${@:2}" || rc=$?
    pull_campaign "${name}"
    return "${rc}"
}

campaign_resubmit() {
    require_campaign_file resubmit "${1:-}"
    local file name rc=0
    file="$(campaign_path "${1}")"
    name="$(campaign_name "${1}")"
    echo "==> [resubmit] proposal for campaign ${name}  @  ${HPC_HOST}   (nothing is submitted)"
    echo "    Approve it, then: $(basename "$0") act resubmit ${1} <proposal file>"
    echo ""
    campaign_remote resubmit "${file}" "${@:2}" || rc=$?
    pull_campaign "${name}"
    return "${rc}"
}

campaign_report() {
    require_campaign_file report "${1:-}"
    local file name rc=0
    file="$(campaign_path "${1}")"
    name="$(campaign_name "${1}")"
    echo "==> [report] campaign ${name}  @  ${HPC_HOST}"
    echo ""
    campaign_remote report "${file}" "${@:2}" || rc=$?
    pull_campaign "${name}"
    return "${rc}"
}

ACT_ACTIONS="submit resubmit hold release throttle update-pending cancel"

# The scontrol fields `act update-pending` may change. A partition is not among them:
# a partition change goes through `python -m autofit.campaign`, whose lint keeps
# CPU-only work off GPU partitions.
ACT_UPDATE_FIELDS="TimeLimit MinMemoryCPU ArrayTaskThrottle Nice"

act_usage() {
    echo "Usage: $(basename "$0") act <action> <campaign.yaml|campaign-name> <arg ...>"
    echo ""
    echo "  submit [--stage S ...] [--indices SPEC] [--dry-run]"
    echo "                                       submit the campaign (needs the .yaml); a pilot"
    echo "                                       is --indices with the pilot's slice"
    echo "  hold <job_id>                        scontrol hold"
    echo "  release <job_id>                     scontrol release"
    echo "  throttle <job_id> <N>                at most N array tasks running at once"
    echo "  update-pending <job_id> <Field=Value ...>"
    echo "                                       change a pending job: ${ACT_UPDATE_FIELDS}"
    echo "  resubmit <proposal.json>             submit an approved proposal (needs the .yaml)"
    echo "  cancel <job_id>                      scancel"
    echo ""
    echo "  Every action is appended to campaign/<name>/actions.log on the cluster."
}

act_fail() {
    echo "ERROR: $*" >&2
    echo "" >&2
    act_usage >&2
    exit 1
}

act() {
    local action="${1:-}" target="${2:-}"
    [[ -n "${action}" && -n "${target}" ]] || act_fail "act needs an action and a campaign"
    [[ " ${ACT_ACTIONS} " == *" ${action} "* ]] || act_fail "unknown action '${action}' (one of: ${ACT_ACTIONS})"
    shift 2
    local args=("$@")

    local name file=""
    if [[ "${target}" == *.y*ml ]]; then
        file="$(campaign_path "${target}")"
        name="$(campaign_name "${target}")"
    else
        name="${target}"
    fi
    [[ "${name}" =~ ^[A-Za-z0-9_.-]+$ ]] || act_fail "campaign name '${name}' may use only letters, digits, _ . -"

    # Every argument is one plain word, so the log line needs no escaping and the
    # remote shell sees exactly what was asked for.
    local arg
    for arg in "${args[@]}"; do
        [[ "${arg}" =~ ^[A-Za-z0-9_=:.,/+@%-]+$ ]] || act_fail "argument '${arg}' has characters act does not pass on"
    done

    local job_pattern='^[0-9]+(_[0-9]+)?$'
    local command
    case "${action}" in
        hold|release|cancel)
            [[ ${#args[@]} -eq 1 && "${args[0]}" =~ ${job_pattern} ]] || act_fail "${action} takes one job id"
            if [[ "${action}" == cancel ]]; then
                command="scancel ${args[0]}"
            else
                command="scontrol ${action} ${args[0]}"
            fi
            ;;
        throttle)
            [[ ${#args[@]} -eq 2 && "${args[0]}" =~ ^[0-9]+$ && "${args[1]}" =~ ^[0-9]+$ ]] \
                || act_fail "throttle takes an array job id and a number"
            command="scontrol update JobId=${args[0]} ArrayTaskThrottle=${args[1]}"
            ;;
        update-pending)
            [[ ${#args[@]} -ge 2 && "${args[0]}" =~ ${job_pattern} ]] \
                || act_fail "update-pending takes a job id and at least one Field=Value"
            local field
            for arg in "${args[@]:1}"; do
                field="${arg%%=*}"
                [[ "${arg}" == *=* && " ${ACT_UPDATE_FIELDS} " == *" ${field} "* ]] \
                    || act_fail "update-pending may change only ${ACT_UPDATE_FIELDS} (got '${arg}')"
            done
            command="scontrol update JobId=${args[0]} ${args[*]:1}"
            ;;
        submit)
            [[ -n "${file}" ]] || act_fail "submit needs the campaign.yaml, not just its name"
            for arg in "${args[@]}"; do
                [[ "${arg}" != --proposal* ]] || act_fail "an approved proposal goes through 'act resubmit'"
            done
            command="{ ${HPC_ENV}; } && ${HPC_PYTHON} -m autofit.campaign submit $(printf '%q' "${file}") ${args[*]}"
            ;;
        resubmit)
            [[ -n "${file}" ]] || act_fail "resubmit needs the campaign.yaml, not just its name"
            [[ ${#args[@]} -eq 1 ]] || act_fail "resubmit takes one approved proposal file"
            local proposal="${args[0]}"
            [[ "${proposal}" == */* ]] || proposal="campaign/${name}/${proposal}"
            command="{ ${HPC_ENV}; } && ${HPC_PYTHON} -m autofit.campaign submit $(printf '%q' "${file}") --proposal ${proposal}"
            ;;
    esac

    local user="${USER:-$(id -un)}"
    [[ "${user}" =~ ^[A-Za-z0-9_.-]+$ ]] || user="unknown"
    local json_args="" first=1
    for arg in "${args[@]}"; do
        (( first )) || json_args+=", "
        json_args+="\"${arg}\""
        first=0
    done
    local log="campaign/${name}/actions.log"

    echo "==> [act] ${action} ${args[*]}  (campaign ${name})  @  ${HPC_HOST}"
    echo ""
    # One ssh call: check the log can be written, run the command, then append the log
    # line with its exit status. A log that cannot be written stops the action before
    # it runs, so nothing changes on the queue unrecorded. The values are plain words
    # (checked above), so single quotes carry them intact.
    local remote
    remote="cd '${REMOTE_PATH}' && mkdir -p 'campaign/${name}' && : >> '${log}' "
    remote+="|| { echo 'ERROR: cannot write ${log}; nothing was done' >&2; exit 1; }; "
    remote+="{ ${command}; }; rc=\$?; "
    remote+="line=\$(printf '{\"utc\": \"%s\", \"user\": \"%s\", \"campaign\": \"%s\", \"action\": \"%s\", \"args\": [%s], \"exit\": %s}' "
    remote+="\"\$(date -u +%Y-%m-%dT%H:%M:%SZ)\" '${user}' '${name}' '${action}' '${json_args}' \"\$rc\"); "
    remote+="echo \"\$line\" >> '${log}'; echo \"\$line\"; exit \$rc"
    local rc=0
    ssh "${HPC_HOST}" "${remote}" || rc=$?
    return "${rc}"
}

# ---------------------------------------------------------------------------
# Inspect commands
# ---------------------------------------------------------------------------

tail_logs() {
    local batch_type="${1:-gpu}"
    if [[ "$batch_type" != "gpu" && "$batch_type" != "cpu" ]]; then
        echo "ERROR: batch type must be 'gpu' or 'cpu', got: ${batch_type}"
        exit 1
    fi
    local log_dir="${HPC_BASE}/${PROJECT_NAME}/hpc/batch_${batch_type}/output"
    echo "<== [tail] streaming batch_${batch_type} logs  ←  ${HPC_HOST}"
    echo "    Ctrl+C to stop."
    echo ""
    # -t allocates a TTY so Ctrl+C reaches tail rather than being swallowed by SSH
    ssh -t "${HPC_HOST}" "
        shopt -s nullglob
        files=(\"${log_dir}\"/*.out)
        if [[ \${#files[@]} -eq 0 ]]; then
            echo 'No .out files yet in ${log_dir}/'
        else
            tail -f \"\${files[@]}\"
        fi
    "
}

du_cmd() {
    local remote="${HPC_BASE}/${PROJECT_NAME}"
    echo "==> [du] remote disk usage  @  ${HPC_HOST}:${remote}"
    echo ""
    ssh "${HPC_HOST}" "
        for d in dataset output; do
            path='${remote}'/\"\$d\"
            if [[ -d \"\$path\" ]]; then
                size=\$(du -sh \"\$path\" 2>/dev/null | cut -f1)
                printf '    %-10s  %s/\n' \"\$size\" \"\$d\"
            else
                printf '    %-10s  %s/\n' '-' \"\$d (not found)\"
            fi
        done
        total=\$(du -sh '${remote}' 2>/dev/null | cut -f1)
        printf '    %-10s  %s\n' \"\$total\" 'total'
        echo ''
        df -h '${remote}' 2>/dev/null | tail -1 | \
            awk '{printf \"    filesystem: %s used of %s (%s free)\n\", \$3, \$2, \$4}'
    "
}

check_cmd() {
    local remote="${HPC_BASE}/${PROJECT_NAME}"
    echo "==> [check] verifying connection and remote setup  @  ${HPC_HOST}"
    echo ""

    local all_ok=1

    printf "    SSH connection ............ "
    if ssh "${HPC_HOST}" "exit 0" 2>/dev/null; then
        echo "OK"
    else
        echo "FAILED"; all_ok=0
    fi

    printf "    Remote project dir ........ "
    if ssh "${HPC_HOST}" "[[ -d '${remote}' ]]" 2>/dev/null; then
        echo "OK  (${remote})"
    else
        echo "NOT FOUND  (${remote})"; all_ok=0
    fi

    printf "    sbatch available .......... "
    if ssh "${HPC_HOST}" "command -v sbatch &>/dev/null" 2>/dev/null; then
        echo "OK"
    else
        echo "NOT FOUND"; all_ok=0
    fi

    echo ""
    echo "    Filesystem:"
    ssh "${HPC_HOST}" "df -h '${HPC_BASE}' 2>/dev/null | tail -1 | \
        awk '{printf \"    %s used of %s (%s free) on %s\n\", \$3, \$2, \$4, \$1}'" || true

    echo ""
    if [[ "$all_ok" -eq 1 ]]; then
        echo "    All checks passed."
    else
        echo "    One or more checks FAILED — review above."
        return 1
    fi
}

clear_logs() {
    local batch_type="${1:-}"

    local types=("gpu" "cpu")
    if [[ -n "$batch_type" ]]; then
        if [[ "$batch_type" != "gpu" && "$batch_type" != "cpu" ]]; then
            echo "ERROR: batch type must be 'gpu' or 'cpu', got: ${batch_type}"
            exit 1
        fi
        types=("$batch_type")
    fi

    echo "==> [clear-logs] will delete .out and .err files"
    echo ""
    for type in "${types[@]}"; do
        for subdir in output error; do
            echo "    local   hpc/batch_${type}/${subdir}/"
            echo "    remote  hpc/batch_${type}/${subdir}/"
        done
    done
    echo ""
    read -r -p "    Delete all the above? [y/N] " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { echo "    Aborted."; return 0; }
    echo ""

    for type in "${types[@]}"; do
        for subdir in output error; do
            local local_dir="${PROJECT_ROOT}/hpc/batch_${type}/${subdir}"
            local remote_dir="${HPC_BASE}/${PROJECT_NAME}/hpc/batch_${type}/${subdir}"

            # Local — only if files exist
            if compgen -G "${local_dir}/*.out" > /dev/null 2>&1 || \
               compgen -G "${local_dir}/*.err" > /dev/null 2>&1; then
                rm -f "${local_dir}"/*.out "${local_dir}"/*.err
                echo "    cleared local   hpc/batch_${type}/${subdir}/"
            fi

            # Remote
            ssh "${HPC_HOST}" "
                shopt -s nullglob
                files=('${remote_dir}'/*.out '${remote_dir}'/*.err)
                if [[ \${#files[@]} -gt 0 ]]; then
                    rm -f \"\${files[@]}\"
                    echo '    cleared remote  hpc/batch_${type}/${subdir}/'
                fi
            " || true
        done
    done
    echo ""
    echo "    Done."
}

print_help() {
    echo "Usage: $(basename "$0") <command> [options]"
    echo ""
    echo "Transfer:"
    echo "  push                         Upload code, config, and data to the HPC"
    echo "  push --no-data               Upload code only"
    echo "  pull [dir ...]               Download SLURM logs then results"
    echo "                               (name result roots to pull only those)"
    echo "  logs                         Download SLURM logs only (fast, use mid-run)"
    echo "  sync                         push then pull (default)"
    echo "  push-data-init               First-time dataset upload via tar pipe"
    echo "  pull-full                    Full output download via tar pipe"
    echo "  status [dir ...]             Dry run — show what would transfer"
    echo ""
    echo "Jobs:"
    echo "  submit [gpu|cpu] <script> [sbatch arg ...]"
    echo "                               Submit a SLURM job; extra arguments go to sbatch"
    echo "  push-submit [gpu|cpu] <script> [sbatch arg ...]"
    echo "                               Push code then submit"
    echo "  jobs                         Show queued/running jobs (squeue)"
    echo "  sacct                        Show job history and exit codes"
    echo "  cancel <job_id>              Cancel a job by ID (logged like act cancel)"
    echo "  wait-and-pull [secs]         Poll until all jobs finish, then pull (default: 60s)"
    echo ""
    echo "Campaigns (python -m autofit.campaign on the cluster):"
    echo "  status <campaign.yaml>       Collect the campaign, pull and print its digest"
    echo "  plan <campaign.yaml> [...]   Propose resources from evidence (submits nothing)"
    echo "  pilot <campaign.yaml> [...]  Choose a stratified pilot slice (submits nothing)"
    echo "  resubmit <campaign.yaml> --stage S --class C"
    echo "                               Write a resubmit proposal (submits nothing)"
    echo "  report <campaign.yaml> [...] End-of-campaign report, energy and carbon"
    echo "  act <action> <campaign.yaml|name> <arg ...>"
    echo "                               Start or change campaign jobs and log it: submit,"
    echo "                               resubmit, hold, release, throttle, update-pending, cancel"
    echo ""
    echo "Inspect:"
    echo "  tail [gpu|cpu]               Stream live SLURM log output (default: gpu)"
    echo "  du                           Show remote disk usage"
    echo "  check                        Verify SSH connection and remote paths"
    echo "  clear-logs [gpu|cpu]         Delete SLURM output/error log files"
    echo ""
    echo "  help                         Show this message"
}

# ---------------------------------------------------------------------------
cmd="${1:-sync}"

if [[ "$HELP_REQUESTED" -eq 1 ]]; then
    print_help
    exit 0
fi

if [[ "${2:-}" == "--no-data" ]]; then
    SKIP_DATA=1
fi

echo ""
echo "Project : ${PROJECT_NAME}"
echo "Remote  : ${REMOTE}"
echo ""

case "$cmd" in
    push)            push ;;
    pull)            restrict_pull_dirs "${@:2}" && pull ;;
    logs)            pull_logs ;;
    sync)            push && echo "" && pull ;;
    push-data-init)  push_data_init ;;
    pull-full)       pull_full ;;
    status)
        # `status <campaign.yaml>` is the campaign digest; `status [dir ...]` the dry run.
        if [[ "${2:-}" == *.y*ml ]]; then
            campaign_status "${@:2}"
        else
            restrict_pull_dirs "${@:2}" && status
        fi
        ;;
    plan)            campaign_plan "${@:2}" ;;
    pilot)           campaign_pilot "${@:2}" ;;
    resubmit)        campaign_resubmit "${@:2}" ;;
    report)          campaign_report "${@:2}" ;;
    act)             act "${@:2}" ;;
    submit)          submit "${@:2}" ;;
    push-submit)     push_submit "${@:2}" ;;
    jobs)            jobs_cmd ;;
    sacct)           sacct_cmd ;;
    cancel)          cancel "${2:-}" ;;
    wait-and-pull)   wait_and_pull "${2:-60}" ;;
    tail)            tail_logs "${2:-gpu}" ;;
    du)              du_cmd ;;
    check)           check_cmd ;;
    clear-logs)      clear_logs "${2:-}" ;;
    *)
        echo "Unknown command: ${cmd}"
        echo ""
        print_help
        exit 1
        ;;
esac

echo ""
echo "Done."
