#!/bin/bash -l

#SBATCH -J lens_run_cpu
#SBATCH -n 1
#SBATCH --cpus-per-task=4
#SBATCH -o output/output.%A_%a.out
#SBATCH -e error/error.%A_%a.err
#SBATCH --partition=cpu
# NEVER add gpu here: CPU arrays on the gpu partition fill both A100 nodes' CPUs and idle all 8 GPUs. (On RAL use --partition=ral.)
#SBATCH -t 18:00:00
#SBATCH --mem=64gb
#SBATCH --array=0-0
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=your.email@example.com

# -------------------------------
# Generic CPU submit template.
#
# Copy or edit this file for your science case. Fill in the job name, --array
# range, SCRIPT, sample and datasets below. The SLURM array runs one dataset
# per task. The script is run with --setup=cpu --number_of_cores=auto: each
# fit picks the designated CPU setup for its likelihood (JAX for a parametric
# source, the Numba sparse route for a pixelized one) and PyAutoFit picks its
# Nautilus workers (one for JAX, one per allocated CPU for Numba). Each fit logs
# its choice as its `Setup:` and `Parallel:` lines.
# -------------------------------

# -------------------------------
# Environment
#
# Set PROJECT_PATH before submitting:
#   export PROJECT_PATH=/path/to/your/project
# -------------------------------
if [ -z "${PROJECT_PATH:-}" ]; then
    PROJECT_PATH=/path/to/your/project
fi

source $PROJECT_PATH/activate.sh

# Kept: JAX must never reach for a GPU this CPU job was not allocated.
export JAX_PLATFORMS=cpu

# Kept: one thread per process. With --number_of_cores=auto a pixelized (Numba)
# stage runs one Nautilus worker per allocated CPU, so each worker must stay
# single-threaded or the node is oversubscribed; Numba prange must not run inside
# the workers, and OMP_NUM_THREADS does not cap Numba, hence NUMBA_NUM_THREADS.
# A JAX stage runs one process on its own thread pool. Set BLAS_THREADS to
# the allocated CPUs only for a NumPy/Numba run with --number_of_cores=1.
BLAS_THREADS=${BLAS_THREADS:-1}
export OPENBLAS_NUM_THREADS=$BLAS_THREADS
export MKL_NUM_THREADS=$BLAS_THREADS
export OMP_NUM_THREADS=$BLAS_THREADS
export NUMBA_NUM_THREADS=$BLAS_THREADS

# -------------------------------
# Modeling script
#
# The pipeline script inside scripts/ to run (generated by the init-slam skill,
# or adapted from hpc/template.py). Change to your script's filename.
# -------------------------------
SCRIPT=imaging.py

# -------------------------------
# Sample
#
# The sample is the subdirectory inside dataset/ that contains the datasets.
# -------------------------------
sample=imaging

# -------------------------------
# Dataset list
#
# Each entry is the name of a subdirectory inside dataset/$sample/.
# Update --array above to match the number of datasets (0 to N-1).
# -------------------------------
datasets=(
my_lens
)

# -------------------------------
# Select dataset for this array task
# -------------------------------
INDEX=$SLURM_ARRAY_TASK_ID
dataset="${datasets[$INDEX]}"

echo "=========================================="
echo "Array job index: $INDEX"
echo "Sample: $sample"
echo "Dataset: $dataset"
date

# -------------------------------
# Run the analysis script.
#
# All path management is handled inside the script via Path(__file__).
# Dataset-specific values (pixel_scale, n_batch, ...) are read from
# dataset/$sample/$dataset/info.json automatically.
# -------------------------------
python3 $PROJECT_PATH/scripts/$SCRIPT --sample=$sample --dataset=$dataset --setup=cpu --number_of_cores=auto

echo "Finished dataset: $dataset"
date
