{
  "description": "Generated by PyAutoMind/scripts/repos_sync.py. Review and trust the current hook definition with Codex /hooks before relying on it.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/validate_pyauto_code.py\"",
            "statusMessage": "Checking PyAuto API symbols"
          }
        ]
      },
      {
        "matcher": "^(send_later|subscribe_pr_activity|ScheduleWakeup|CronCreate|RemoteTrigger|mcp__.*(send_later|subscribe_pr_activity).*)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/end-at-deliverable.sh\"",
            "statusMessage": "Enforcing the end-at-deliverable policy"
          }
        ]
      }
    ]
  }
}
